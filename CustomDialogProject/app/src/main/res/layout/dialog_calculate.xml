<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="15dp">

            <TextView
                android:id="@+id/calculator_expression"
                android:layout_width="match_parent"
                android:layout_height="23dp"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="#31442B" />

            <TextView
                android:id="@+id/calculator_value"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeStepGranularity="1sp"
                android:text="0"
                android:textColor="#26351E"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="AC"
                android:contentDescription="전체 지우기"
                android:src="@drawable/sign_allclear" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="C"
                android:contentDescription="현재 입력 지우기"
                android:src="@drawable/sign_clear" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="×"
                android:contentDescription="곱하기"
                android:src="@drawable/op_multiply" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="÷"
                android:contentDescription="나누기"
                android:src="@drawable/op_divide" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="7"
                android:contentDescription="7"
                android:src="@drawable/num7" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="8"
                android:contentDescription="8"
                android:src="@drawable/num8" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="9"
                android:contentDescription="9"
                android:src="@drawable/num9" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="−"
                android:contentDescription="빼기"
                android:src="@drawable/op_subtract" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="4"
                android:contentDescription="4"
                android:src="@drawable/num4" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="5"
                android:contentDescription="5"
                android:src="@drawable/num5" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="6"
                android:contentDescription="6"
                android:src="@drawable/num6" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="+"
                android:contentDescription="더하기"
                android:src="@drawable/op_plus" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:tag="1"
                        android:contentDescription="1"
                        android:src="@drawable/num1" />

                    <ImageButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:tag="2"
                        android:contentDescription="2"
                        android:src="@drawable/num2" />

                    <ImageButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:tag="3"
                        android:contentDescription="3"
                        android:src="@drawable/num3" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:tag="←"
                        android:contentDescription="한 글자 지우기"
                        android:src="@drawable/sign_back" />

                    <ImageButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:tag="0"
                        android:contentDescription="0"
                        android:src="@drawable/num0" />

                    <ImageButton
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackground"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:tag="."
                        android:contentDescription="소수점"
                        android:src="@drawable/dot" />

                </LinearLayout>

            </LinearLayout>

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:background="?attr/selectableItemBackground"
                android:padding="2dp"
                android:scaleType="fitCenter"
                android:tag="="
                android:contentDescription="결과"
                android:src="@drawable/op_equal" />

        </LinearLayout>

        <Button
            android:id="@+id/close_calculator"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="닫기"
            android:textColor="#FFFFFF"
            app:backgroundTint="#BC356F" />

    </LinearLayout>
</ScrollView>
