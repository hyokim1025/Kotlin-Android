<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/checkout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#338C8D"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#FFFFFF" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="23sp"
            android:textColor="#247289"
            android:text="주문서"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingVertical="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/order_date"
            android:textSize="13sp"
            android:textColor="#90274B"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#212121"
            android:text="배송주소"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/order_address"
            android:textSize="13sp"
            android:textColor="#212121"
            android:maxLines="5"
            android:ellipsize="end"
            android:paddingVertical="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#B0DEDF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="4"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8C322D"
                android:text="도서명"
                android:textStyle="bold"
                android:gravity="start" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8C322D"
                android:text="가격"
                android:textStyle="bold"
                android:gravity="end" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8C322D"
                android:text="수량"
                android:textStyle="bold"
                android:gravity="end" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8C322D"
                android:text="소계"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/order_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/order_total"
        android:textSize="17sp"
        android:textColor="#8C322D"
        android:textStyle="bold"
        android:gravity="end"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80CDD0"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/order_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minHeight="48dp"
            android:text="주문취소"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />

        <Button
            android:id="@+id/order_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minHeight="48dp"
            android:text="주문완료"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />
    </LinearLayout>
</LinearLayout>
