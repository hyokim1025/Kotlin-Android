<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/checkout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#338C8D"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <Button
            android:id="@+id/memo_add"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="등록"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />

        <Button
            android:id="@+id/memo_edit"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="수정"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />

        <Button
            android:id="@+id/memo_delete"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="삭제"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/memo_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#E4E4E4"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/memo_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="22dp"
            android:textColor="#545454"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
