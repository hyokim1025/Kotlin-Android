<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/checkout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#338C8D"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#FFFFFF" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="23sp"
                android:textColor="#247289"
                android:text="배송 정보"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#212121"
                android:text="배송정보"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/shipping_name"
                    android:text="성명"
                    android:textColor="#303030" />

                <EditText
                    android:id="@+id/shipping_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:inputType="textPersonName"
                    android:textColor="#201E1E"
                    android:maxLength="60" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/shipping_date"
                    android:text="배송일"
                    android:textColor="#303030" />

                <EditText
                    android:id="@+id/shipping_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:inputType="none"
                    android:textColor="#201E1E"
                    android:focusable="false"
                    android:clickable="true"
                    android:hint="배송일 선택"
                    android:textColorHint="#666666"
                    android:freezesText="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/shipping_phone"
                    android:text="연락처"
                    android:textColor="#303030" />

                <EditText
                    android:id="@+id/shipping_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:inputType="phone"
                    android:textColor="#201E1E"
                    android:maxLength="24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/shipping_zip"
                    android:text="우편번호"
                    android:textColor="#303030" />

                <EditText
                    android:id="@+id/shipping_zip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:inputType="number"
                    android:textColor="#201E1E"
                    android:maxLength="10" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/shipping_address"
                    android:text="주소"
                    android:textColor="#303030" />

                <EditText
                    android:id="@+id/shipping_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:inputType="textPostalAddress"
                    android:textColor="#201E1E"
                    android:maxLength="200" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80CDD0"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/shipping_submit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minHeight="48dp"
            android:text="등록"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />

        <Button
            android:id="@+id/shipping_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minHeight="48dp"
            android:text="취소"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />
    </LinearLayout>
</LinearLayout>
