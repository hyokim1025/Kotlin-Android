<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/checkout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#338C8D"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        app:titleTextColor="#FFFFFF" />

    <FrameLayout
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="top|start"
            android:background="@drawable/profile_avatar_background"
            android:clipToOutline="true"
            android:contentDescription="프로필 이미지"
            android:scaleType="centerCrop"
            android:src="@drawable/mypage_user" />

        <ImageButton
            android:id="@+id/profile_edit"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="프로필 사진 설정"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/mypage_modify" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="프로필"
        android:textColor="#263238"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/open_memo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:gravity="start|center_vertical"
        android:minHeight="48dp"
        android:text="메모장  ›"
        android:textColor="#2F1900"
        app:backgroundTint="#FFAA4F" />
</LinearLayout>
