<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/checkout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/checkout_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#338C8D"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#FFFFFF" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <CheckBox
            android:id="@+id/cart_select_all"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="전부 선택"
            android:textColor="#212121" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/cart_empty"
            android:textSize="15sp"
            android:textColor="#212121"
            android:text="장바구니가 비어 있습니다"
            android:gravity="center"
            android:padding="18dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cart_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/cart_total"
        android:textSize="17sp"
        android:textColor="#8C322D"
        android:text="합계 0원"
        android:textStyle="bold"
        android:gravity="end"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80CDD0"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/cart_order"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:minHeight="48dp"
            android:text="주문하기"
            android:textColor="#2F1900"
            app:backgroundTint="#FFAA4F" />
    </LinearLayout>
</LinearLayout>
